{
  "name": "nfo-cli",
  "version": "0.0.3",
  "description": "No Fluff Orchestra — a simple, fluff-free CLI multi-agent orchestrator",
  "type": "module",
  "bin": {
    "nfo": "./dist/cli.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "orchestraror",
    "mcp",
    "agents"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/headless": "^6.0.0",
    "chokidar": "^5.0.0",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "ink": "^7.0.0",
    "node-pty": "^1.1.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
