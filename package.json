{
  "name": "nfo-cli",
  "version": "0.0.7",
  "description": "No Fluff Orchestra — a simple, fluff-free CLI multi-agent orchestrator",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javierfurus/nfo.git"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "nfo": "./dist/cli.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "orchestraror",
    "mcp",
    "agents"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "pretest": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/headless": "^6.0.0",
    "chokidar": "^5.0.0",
    "commander": "^12.0.0",
    "execa": "^9.0.0",
    "ink": "^7.0.5",
    "markdansi": "^0.3.1",
    "node-pty": "^1.1.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0",
    "vite": "^8.0.16",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
